# RAPCA Campo — Configuración Apache
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Proteger archivos sensibles
<FilesMatch "(config\.php|\.env|\.git)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>

# Proteger directorio tmp
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^tmp/ - [F,L]
    RewriteRule ^includes/ - [F,L]
</IfModule>

# Cache estático.
# HTML/JS/CSS SIEMPRE revalidan contra el servidor: con cache larga, los
# navegadores reutilizaban los .js viejos hasta 7 días y las actualizaciones
# no llegaban a los móviles (el Service Worker ya da el modo offline, la
# caché HTTP de estos archivos solo estorba). Con ETag, revalidar es un 304
# barato. Las imágenes sí se cachean largo.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 0 seconds"
    ExpiresByType application/javascript "access plus 0 seconds"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType application/json "access plus 0 seconds"
</IfModule>
<IfModule mod_headers.c>
    <FilesMatch "\.(js|html|css)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>
